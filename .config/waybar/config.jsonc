{
    "layer": "top",
    "position": "top",
    "modules-left": ["memory", "cpu", "temperature", "battery"],
    "modules-center": ["hyprland/workspaces"],
    "modules-right": ["pulseaudio", "network", "clock", "tray", "custom/notification", "group/group-power"], // "custom/lock", "custom/power"],
    "hyprland/workspaces": {
        "format": "{icon}",
      	"on-click": "activate",
        "format-icons": {
		"1": "I",
		"2": "II",
		"3": "III",
		"4": "IV",
		"5": "V",
		"6": "VI",
		"7": "VII",
		"8": "VIII",
		"9": "IX",
		"10": "X"
//   	 	"urgent": "",
//  	        "active": "",
//  	        "default": ""
        }
   },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": " ",
        "format-icons": {
            "default": ["", "", " "]
        },
        "on-click": "pavucontrol"
    },
    "temperature": {
      "format": "{temperatureC}°C"
    },
    "network": {
    "format": "{ifname}",
    "format-wifi": " {essid} ({signalStrength}%)",
    "format-ethernet": " {ipaddr}/{cidr}",
    "format-disconnected": "Disconnected",
    "tooltip-format": "{ifname} via {gwaddr} 󰊗 ",
    "tooltip-format-wifi": "{essid} ({signalStrength}%)  ",
    "tooltip-format-ethernet": "{ifname}  ",
    "tooltip-format-disconnected": "Disconnected :(",
    "max-length": 50
    },
    "memory": {
    "interval": 3,
    "format": "{}%  ",
    "max-length": 10,
    "on-click": "kitty htop"
    },
    "cpu": {
    "interval": 3,
    "format": "{}%  ",
    "max-length": 10,
    "on-click": "kitty htop"
    },
    "battery": {
    "bat": "BAT0",
    "interval": 3,
    "states": {
        "warning": 30,
        "critical": 15
    },
    "format": "{capacity}% {icon}",
    "format-charging": " {capacity}%",
    "format-icons": [" ", " ", " ", " ", " "],
    "max-length": 25
    },
    "tray": {
        "icon-size": 21,
        "spacing": 10
    },
    "clock": {
        "timezone": "Europe/Athens",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "format-alt": " {:%d/%m/%Y}",
        "format": "  {:%H:%M}"
    },
    "custom/lock": {
        "tooltip": "Lock the computer",
        "on-click": "hyprlock &",
        "format": ""
    },
    "custom/power": {
        "tooltip": "Reboot the computer",
        "on-click": "reboot",
        "format": "⏻"
    },
    "group/group-power": {
    "orientation": "inherit",
    "drawer": {
        "transition-duration": 500,
        "children-class": "not-power",
        "transition-left-to-right": false
    },
    "modules": [
        "custom/power", // First element is the "group leader" and won't ever be hidden
        "custom/quit",
        "custom/lock",
        "custom/reboot"
    ]
    },
    "custom/quit": {
        "format": "󰗼 ",
        "tooltip": false,
        "on-click": "hyprctl dispatch exit"
    },
    "custom/lock": {
        "format": "󰍁 ",
        "tooltip": false,
        "on-click": "hyprlock"
    },
    "custom/reboot": {
        "format": "󰜉 ",
        "tooltip": false,
        "on-click": "reboot"
    },
    "custom/power": {
        "format": " ",
        "tooltip": false,
        "on-click": "systemctl poweroff"
    },
    "custom/notification": {
	"format": " ",
	"tooltip": "Click to show notifications", 
	"on-click": "swaync-client -t"
    }
}
